{
  "name": "dktech-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DKTech artist website. Zagreb, Croatia.",
  "scripts": {
    "data": "node scripts/build-catalogue.mjs",
    "media": "node scripts/prepare-media.mjs",
    "prepare:all": "npm run data && npm run media",
    "merge": "node scripts/merge-catalogue.mjs",
    "sync:spotify": "node scripts/sync-spotify.mjs",
    "dev": "node scripts/merge-catalogue.mjs && vite",
    "build": "node scripts/merge-catalogue.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/test/*.test.mjs\"",
    "lint:dashes": "node scripts/check-dashes.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
